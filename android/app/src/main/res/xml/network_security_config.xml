<?xml version="1.0" encoding="utf-8"?>
<!-- Tank devices serve plain HTTP on the local network (their own hotspot or the home Wi-Fi). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
