<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/brand_teal" app:title="@string/firmware_title"
        app:titleTextColor="@color/white" app:subtitleTextColor="@color/white" app:navigationIcon="@drawable/ic_back" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <TextView android:id="@+id/fwDevice" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
            <TextView android:id="@+id/fwBundled" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:textAppearance="?attr/textAppearanceBodyMedium" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnBundled"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnFile"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/firmware_file" />
            <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/fwProgress"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
                android:max="100" android:visibility="gone" app:trackThickness="8dp" app:trackCornerRadius="4dp" />
            <TextView android:id="@+id/fwStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:textAppearance="?attr/textAppearanceBodyMedium" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
                android:text="@string/firmware_note" android:textAppearance="?attr/textAppearanceBodySmall" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
